<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
             https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="orderingPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.orderingsystem.core.domain.User</class>
        <class>com.orderingsystem.core.domain.Site</class>
        <class>com.orderingsystem.core.domain.SiteMerchandise</class>
        <class>com.orderingsystem.core.domain.StandardMerchandise</class>
        <class>com.orderingsystem.core.domain.ImportRequest</class>
        <class>com.orderingsystem.core.domain.ImportRequestItem</class>
        <class>com.orderingsystem.core.domain.InventoryQuery</class>
        <class>com.orderingsystem.core.domain.PurchaseOrder</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.sqlite.JDBC"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:sqlite:data/ordering.db"/>

            <property name="hibernate.dialect" value="org.hibernate.community.dialect.SQLiteDialect"/>
            <!-- update: tạo/cập nhật bảng từ @Entity khi chạy (phù hợp giai đoạn dev/demo) -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
