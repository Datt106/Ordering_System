<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderingsystem.fx.presentation.warehouse.WarehouseReconcileController"
      spacing="16" styleClass="screen" maxWidth="Infinity">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Đối chiếu nhập kho" styleClass="screen-title"/>
    <Label fx:id="screenStatusLabel" styleClass="screen-status" wrapText="true" maxWidth="Infinity"/>

    <VBox styleClass="content-card" maxWidth="Infinity">
        <Label text="Ghi nhận nhập" styleClass="section-heading"/>
        <HBox spacing="12" alignment="BOTTOM_LEFT">
            <VBox spacing="6">
                <Label text="Số lượng thực nhận" styleClass="field-label"/>
                <Spinner fx:id="actualSpinner" prefWidth="120"/>
            </VBox>
            <VBox spacing="6" alignment="BOTTOM_LEFT">
                <Label text=" " styleClass="field-label"/>
                <HBox spacing="8">
                    <Button text="Làm mới" onAction="#onRefresh" styleClass="btn-secondary"/>
                    <Button text="Ghi nhận" onAction="#onReconcile" styleClass="btn-primary"/>
                </HBox>
            </VBox>
        </HBox>
    </VBox>

    <VBox styleClass="content-card" VBox.vgrow="ALWAYS" maxWidth="Infinity">
        <Label text="Đơn cần đối chiếu" styleClass="section-heading"/>
        <Label fx:id="emptyStateLabel" styleClass="empty-state" wrapText="true" managed="false" visible="false"/>
        <VBox styleClass="table-container" VBox.vgrow="ALWAYS" maxWidth="Infinity">
            <TableView fx:id="table" styleClass="catalog-table" VBox.vgrow="ALWAYS" minHeight="280" maxWidth="Infinity">
                <columns>
                    <TableColumn fx:id="orderIdCol" text="Mã đơn" sortable="true"/>
                    <TableColumn fx:id="siteCol" text="Site" sortable="true"/>
                    <TableColumn fx:id="codeCol" text="Mã hàng" sortable="true"/>
                    <TableColumn fx:id="orderedCol" text="SL đặt" sortable="true"/>
                    <TableColumn fx:id="statusCol" text="Trạng thái" sortable="true"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</VBox>
