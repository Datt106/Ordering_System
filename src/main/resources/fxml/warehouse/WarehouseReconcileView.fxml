<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderingsystem.fx.presentation.warehouse.WarehouseReconcileController"
      spacing="16" styleClass="screen" maxWidth="Infinity" VBox.vgrow="ALWAYS">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Đối chiếu nhập kho" styleClass="screen-title"/>

    <VBox styleClass="content-card" maxWidth="Infinity">
        <Label text="Ghi nhận nhập" styleClass="section-heading"/>
        <HBox spacing="16" alignment="CENTER_LEFT">
            <VBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Số lượng thực nhận" styleClass="field-label"/>
                <TextField fx:id="actualField" promptText="0" prefWidth="140" styleClass="uniform-field"/>
            </VBox>
            
            <VBox spacing="6" alignment="CENTER_LEFT">
                <Label text="Thời gian hàng đến (dd/MM/yyyy HH:mm)" styleClass="field-label"/>
                <TextField fx:id="timeField" promptText="05/06/2026 14:30" prefWidth="250" styleClass="uniform-field"/>
            </VBox>

            <VBox spacing="6" alignment="CENTER_LEFT">
                <Label text=" " styleClass="field-label"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button text="Làm mới" onAction="#onRefresh" prefHeight="40" styleClass="btn-secondary"/>
                    <Button fx:id="reconcileButton" text="Ghi nhận" onAction="#onReconcile" prefHeight="40" styleClass="btn-primary"/>
                </HBox>
            </VBox>
        </HBox>
    </VBox>

    <VBox styleClass="content-card" maxWidth="Infinity" maxHeight="Infinity" VBox.vgrow="ALWAYS">
        <Label text="Kết quả" styleClass="section-heading"/>
        <TableView fx:id="table" styleClass="catalog-table" maxWidth="Infinity" maxHeight="Infinity" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="orderIdCol" text="Mã đơn" sortable="true"/>
                <TableColumn fx:id="siteCol" text="Site" sortable="true"/>
                <TableColumn fx:id="codeCol" text="Mã hàng" sortable="true"/>
                <TableColumn fx:id="orderedCol" text="SL đặt" sortable="true"/>
                <TableColumn fx:id="statusCol" text="Trạng thái" sortable="true"/>
            </columns>
        </TableView>
    </VBox>
</VBox>