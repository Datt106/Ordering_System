<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderingsystem.fx.presentation.warehouse.WarehouseOrdersController"
      spacing="16" styleClass="screen" maxWidth="Infinity">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Danh sách đơn hàng" styleClass="screen-title"/>

    <VBox styleClass="content-card" maxWidth="Infinity">
        <Label text="Tìm kiếm" styleClass="section-heading"/>
        <HBox spacing="12" alignment="BOTTOM_LEFT">
            <VBox spacing="6">
                <Label text="Trạng thái" styleClass="field-label"/>
                <ComboBox fx:id="statusFilter" prefWidth="160"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Mã Site" styleClass="field-label"/>
                <TextField fx:id="siteFilter" promptText="Tất cả" prefWidth="100"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Mã hàng" styleClass="field-label"/>
                <TextField fx:id="merchandiseFilter" promptText="Tất cả" prefWidth="100"/>
            </VBox>
            <VBox spacing="6" alignment="BOTTOM_LEFT">
                <Label text=" " styleClass="field-label"/>
                <Button text="Tìm" onAction="#onSearch" styleClass="btn-primary"/>
            </VBox>
        </HBox>
    </VBox>

    <VBox styleClass="content-card" maxWidth="Infinity">
        <Label text="Kết quả" styleClass="section-heading"/>
        <VBox styleClass="table-container" prefHeight="240" minHeight="240" maxHeight="240" maxWidth="Infinity">
            <TableView fx:id="table" styleClass="catalog-table" minHeight="280" maxWidth="Infinity">
                <columns>
                    <TableColumn fx:id="orderIdCol" text="Mã đơn" sortable="true"/>
                    <TableColumn fx:id="requestCol" text="Yêu cầu" sortable="true"/>
                    <TableColumn fx:id="siteCol" text="Site" sortable="true"/>
                    <TableColumn fx:id="codeCol" text="Mã hàng" sortable="true"/>
                    <TableColumn fx:id="qtyCol" text="SL" sortable="true"/>
                    <TableColumn fx:id="statusCol" text="Trạng thái" sortable="true"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</VBox>
