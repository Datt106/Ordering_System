<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderingsystem.fx.presentation.overseas.OverseasSitesController"
      spacing="16" styleClass="screen" maxWidth="Infinity">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Quản lý Site" styleClass="screen-title"/>

    <VBox styleClass="content-card" maxWidth="Infinity">
        <Label text="Danh sách Site" styleClass="section-heading"/>
        <HBox spacing="8" styleClass="toolbar" alignment="CENTER_LEFT">
            <Button text="Làm mới" onAction="#onRefresh" styleClass="btn-secondary"/>
            <Button fx:id="addButton" text="Thêm" onAction="#onShowAddForm" styleClass="btn-primary"/>
            <Button fx:id="updateButton" text="Sửa" onAction="#onShowEditForm" styleClass="btn-secondary"/>
            <Button fx:id="deleteButton" text="Xóa" onAction="#onDelete" styleClass="btn-danger"/>
        </HBox>
        <VBox fx:id="tableContainer" styleClass="table-container" prefHeight="220" minHeight="220" maxHeight="220" maxWidth="Infinity">
            <TableView fx:id="table" styleClass="catalog-table" maxWidth="Infinity">
                <columns>
                    <TableColumn fx:id="codeCol" text="Mã" sortable="true"/>
                    <TableColumn fx:id="nameCol" text="Tên" sortable="true"/>
                    <TableColumn fx:id="otherCol" text="Thông tin khác" sortable="true"/>
                    <TableColumn fx:id="shipCol" text="Vận chuyển" sortable="true"/>
                    <TableColumn fx:id="statusCol" text="Trạng thái" sortable="true"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>

    <VBox fx:id="formPanel" visible="false" managed="false" styleClass="content-card form-panel" maxWidth="Infinity">
        <HBox styleClass="form-panel-header" alignment="CENTER_LEFT">
            <Label fx:id="formTitleLabel" text="Thêm Site" styleClass="section-heading" HBox.hgrow="ALWAYS"/>
            <Button text="✕" onAction="#onFormClose" styleClass="btn-icon-close"/>
        </HBox>
        <GridPane hgap="16" vgap="16">
            <columnConstraints>
                <ColumnConstraints minWidth="120" prefWidth="140"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
            </columnConstraints>
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2" maxWidth="Infinity">
                <Label text="Mã Site" styleClass="field-label"/>
                <TextField fx:id="codeField" promptText="vd. SITE01" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2" maxWidth="Infinity">
                <Label text="Tên" styleClass="field-label"/>
                <TextField fx:id="nameField" promptText="Tên đối tác Site" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2" maxWidth="Infinity">
                <Label text="Thông tin khác" styleClass="field-label"/>
                <TextArea fx:id="otherArea" prefRowCount="3" promptText="Ghi chú (tùy chọn)" wrapText="true" maxWidth="Infinity"/>
            </VBox>
        </GridPane>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button fx:id="formOkButton" text="Ok" onAction="#onFormOk" styleClass="btn-primary"/>
        </HBox>
    </VBox>
</VBox>
