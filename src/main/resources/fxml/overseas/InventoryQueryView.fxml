<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderingsystem.fx.presentation.overseas.OverseasInventoryController"
      spacing="16" styleClass="screen" maxWidth="Infinity">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Truy vấn tồn kho" styleClass="screen-title"/>
    <Label fx:id="screenStatusLabel" styleClass="screen-status" wrapText="true" maxWidth="Infinity"/>

    <VBox styleClass="content-card" maxWidth="Infinity">
        <Label text="Thao tác" styleClass="section-heading"/>
        <HBox spacing="8" styleClass="toolbar" alignment="CENTER_LEFT">
            <Button text="Làm mới" onAction="#onRefresh" styleClass="btn-secondary"/>
            <Button text="Gửi truy vấn" onAction="#onDispatch" styleClass="btn-primary"/>
            <Button text="Xem trạng thái" onAction="#onStatus" styleClass="btn-secondary"/>
            <Button text="Timeout → 0" onAction="#onTimeoutZero" styleClass="btn-danger"/>
        </HBox>
    </VBox>

    <VBox styleClass="content-card" VBox.vgrow="ALWAYS" maxWidth="Infinity">
        <Label text="Yêu cầu đang xử lý" styleClass="section-heading"/>
        <SplitPane dividerPositions="0.45" VBox.vgrow="ALWAYS" maxWidth="Infinity">
            <VBox spacing="8" maxWidth="Infinity">
                <Label fx:id="emptyStateLabel" styleClass="empty-state" wrapText="true" managed="false" visible="false"/>
                <VBox styleClass="table-container" VBox.vgrow="ALWAYS" maxWidth="Infinity">
                    <TableView fx:id="processingTable" styleClass="catalog-table" VBox.vgrow="ALWAYS" minHeight="240" maxWidth="Infinity">
                        <columns>
                            <TableColumn fx:id="idCol" text="Mã YC" sortable="true"/>
                            <TableColumn fx:id="byCol" text="Tiếp nhận bởi" sortable="true"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
            <VBox spacing="8" styleClass="detail-panel" maxWidth="Infinity">
                <padding>
                    <Insets top="8" right="8" bottom="8" left="16"/>
                </padding>
                <Label text="Kết quả truy vấn" styleClass="section-heading"/>
                <TextArea fx:id="resultArea" VBox.vgrow="ALWAYS" editable="false" wrapText="true"
                          promptText="Kết quả truy vấn hiển thị tại đây…" maxWidth="Infinity"/>
            </VBox>
        </SplitPane>
    </VBox>
</VBox>
