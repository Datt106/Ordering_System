<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderingsystem.fx.presentation.site.SiteMerchandiseController"
      spacing="16" styleClass="screen" maxWidth="Infinity" VBox.vgrow="ALWAYS">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Mặt hàng kinh doanh" styleClass="screen-title"/>

    <VBox styleClass="content-card" maxWidth="Infinity" VBox.vgrow="ALWAYS">
        <Label text="Danh sách mặt hàng kinh doanh" styleClass="section-heading"/>
        <HBox spacing="8" styleClass="toolbar" alignment="CENTER_LEFT">
            <Button text="Thêm" onAction="#onShowAddForm" styleClass="btn-primary"/>
            <Button text="Xóa" onAction="#onRemove" styleClass="btn-danger"/>
            <Button text="Làm mới" onAction="#onRefresh" styleClass="btn-secondary"/>
        </HBox>
        <VBox fx:id="tableContainer" styleClass="table-container" maxWidth="Infinity" VBox.vgrow="ALWAYS">
            <TableView fx:id="table" styleClass="catalog-table" maxWidth="Infinity" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="codeCol" text="Mã" sortable="true"/>
                    <TableColumn fx:id="nameCol" text="Tên" sortable="true"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>

    <VBox fx:id="formPanel" visible="false" managed="false" styleClass="content-card form-panel" maxWidth="Infinity">
        <HBox styleClass="form-panel-header" alignment="CENTER_LEFT">
            <Label text="Thêm mặt hàng kinh doanh" styleClass="section-heading" HBox.hgrow="ALWAYS"/>
            <Button text="✕" onAction="#onFormClose" styleClass="btn-icon-close"/>
        </HBox>
        <VBox spacing="6" maxWidth="Infinity">
            <Label text="Mã hàng (danh mục chuẩn)" styleClass="field-label"/>
            <ComboBox fx:id="catalogCombo" editable="true" maxWidth="Infinity" styleClass="uniform-field"/>
        </VBox>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Button text="Ok" onAction="#onFormOk" styleClass="btn-primary"/>
        </HBox>
    </VBox>
</VBox>