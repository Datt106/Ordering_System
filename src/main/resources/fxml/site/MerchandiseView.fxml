<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderingsystem.fx.presentation.site.SiteMerchandiseController"
      spacing="16" styleClass="screen" maxWidth="Infinity">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Mặt hàng kinh doanh" styleClass="screen-title"/>
    <Label fx:id="screenStatusLabel" styleClass="screen-status" wrapText="true" maxWidth="Infinity"/>

    <VBox styleClass="content-card" maxWidth="Infinity">
        <Label text="Thêm mặt hàng" styleClass="section-heading"/>
        <HBox spacing="12" alignment="BOTTOM_LEFT" wrapText="true">
            <VBox spacing="6">
                <Label text="Mã hàng (danh mục chuẩn)" styleClass="field-label"/>
                <ComboBox fx:id="catalogCombo" prefWidth="160"/>
            </VBox>
            <VBox spacing="6" alignment="BOTTOM_LEFT">
                <Label text=" " styleClass="field-label"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button text="Thêm" onAction="#onAdd" styleClass="btn-primary"/>
                    <Button text="Xóa" onAction="#onRemove" styleClass="btn-danger"/>
                    <Button text="Làm mới" onAction="#onRefresh" styleClass="btn-secondary"/>
                </HBox>
            </VBox>
        </HBox>
    </VBox>

    <VBox styleClass="content-card" VBox.vgrow="ALWAYS" maxWidth="Infinity">
        <Label text="Danh sách mặt hàng kinh doanh" styleClass="section-heading"/>
        <Label fx:id="emptyStateLabel" styleClass="empty-state" wrapText="true" managed="false" visible="false"/>
        <VBox styleClass="table-container" VBox.vgrow="ALWAYS" maxWidth="Infinity">
            <TableView fx:id="table" styleClass="catalog-table" VBox.vgrow="ALWAYS" minHeight="220" maxWidth="Infinity">
                <columns>
                    <TableColumn fx:id="codeCol" text="Mã" sortable="true"/>
                    <TableColumn fx:id="nameCol" text="Tên" sortable="true"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</VBox>
