<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderingsystem.fx.presentation.site.SiteShippingController"
      spacing="16" styleClass="screen" maxWidth="Infinity">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Thông tin vận chuyển" styleClass="screen-title"/>

    <VBox styleClass="content-card" maxWidth="Infinity">
        <Label text="Thông tin Site" styleClass="section-heading"/>
        <GridPane hgap="16" vgap="16">
            <columnConstraints>
                <ColumnConstraints minWidth="140" prefWidth="180" hgrow="NEVER"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="200"/>
            </columnConstraints>
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="Mã Site" styleClass="field-label"/>
                <Label fx:id="siteCodeLabel" styleClass="field-value"/>
            </VBox>
            <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="Tên" styleClass="field-label"/>
                <Label fx:id="siteNameLabel" styleClass="field-value"/>
            </VBox>
            <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2" maxWidth="Infinity">
                <Label text="Trạng thái vận chuyển" styleClass="field-label"/>
                <Label fx:id="shippingStatusLabel" styleClass="field-value"/>
            </VBox>
        </GridPane>
    </VBox>

    <VBox styleClass="content-card" maxWidth="Infinity">
        <Label text="Khai báo vận chuyển" styleClass="section-heading"/>
        <HBox spacing="24" alignment="CENTER_LEFT">
            <VBox spacing="6">
                <Label text="Số ngày tàu" styleClass="field-label"/>
                <Spinner fx:id="shipSpinner" prefWidth="120"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Số ngày bay" styleClass="field-label"/>
                <Spinner fx:id="airSpinner" prefWidth="120"/>
            </VBox>
        </HBox>
    </VBox>

    <VBox styleClass="content-card" maxWidth="Infinity">
        <Label text="Thao tác" styleClass="section-heading"/>
        <HBox spacing="8" styleClass="toolbar" alignment="CENTER_LEFT">
            <Button text="Làm mới" onAction="#onRefresh" styleClass="btn-secondary"/>
            <Button text="Lưu vận chuyển" onAction="#onSave" styleClass="btn-primary"/>
        </HBox>
    </VBox>
</VBox>
