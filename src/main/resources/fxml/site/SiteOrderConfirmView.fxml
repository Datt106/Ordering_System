<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderingsystem.fx.presentation.site.SiteOrderConfirmController"
      spacing="16" styleClass="screen" maxWidth="Infinity">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Tiếp nhận đơn hàng" styleClass="screen-title"/>
    <Label fx:id="screenStatusLabel" styleClass="screen-status" wrapText="true" maxWidth="Infinity"/>

    <VBox styleClass="content-card" maxWidth="Infinity">
        <Label text="Thao tác" styleClass="section-heading"/>
        <HBox spacing="8" styleClass="toolbar" alignment="CENTER_LEFT">
            <Button text="Làm mới" onAction="#onRefresh" styleClass="btn-secondary"/>
            <Button text="Xác nhận" onAction="#onConfirm" styleClass="btn-primary"/>
            <Button text="Từ chối" onAction="#onReject" styleClass="btn-danger"/>
        </HBox>
    </VBox>

    <VBox styleClass="content-card" VBox.vgrow="ALWAYS" maxWidth="Infinity">
        <Label text="Đơn chờ Site xử lý" styleClass="section-heading"/>
        <Label fx:id="emptyStateLabel" styleClass="empty-state" wrapText="true" managed="false" visible="false"/>
        <VBox styleClass="table-container" VBox.vgrow="ALWAYS" maxWidth="Infinity">
            <TableView fx:id="table" styleClass="catalog-table" VBox.vgrow="ALWAYS" minHeight="280" maxWidth="Infinity">
                <columns>
                    <TableColumn fx:id="orderIdCol" text="Mã đơn" sortable="true"/>
                    <TableColumn fx:id="requestCol" text="Yêu cầu" sortable="true"/>
                    <TableColumn fx:id="codeCol" text="Mã hàng" sortable="true"/>
                    <TableColumn fx:id="qtyCol" text="SL" sortable="true"/>
                    <TableColumn fx:id="shipCol" text="Vận chuyển" sortable="true"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</VBox>
