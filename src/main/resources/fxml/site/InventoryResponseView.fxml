<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderingsystem.fx.presentation.site.SiteInventoryResponseController"
      spacing="16" styleClass="screen" maxWidth="Infinity">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Xác nhận tồn kho" styleClass="screen-title"/>
    <Label fx:id="screenStatusLabel" styleClass="screen-status" wrapText="true" maxWidth="Infinity"/>

    <VBox styleClass="content-card" maxWidth="Infinity">
        <Label text="Phản hồi tồn kho" styleClass="section-heading"/>
        <HBox spacing="12" alignment="BOTTOM_LEFT">
            <VBox spacing="6">
                <Label text="Số lượng tồn" styleClass="field-label"/>
                <Spinner fx:id="stockSpinner" prefWidth="120"/>
            </VBox>
            <VBox spacing="6" alignment="BOTTOM_LEFT">
                <Label text=" " styleClass="field-label"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button text="Làm mới" onAction="#onRefresh" styleClass="btn-secondary"/>
                    <Button text="Gửi phản hồi" onAction="#onRespond" styleClass="btn-primary"/>
                </HBox>
            </VBox>
        </HBox>
    </VBox>

    <VBox styleClass="content-card" VBox.vgrow="ALWAYS" maxWidth="Infinity">
        <Label text="Truy vấn chờ phản hồi" styleClass="section-heading"/>
        <Label fx:id="emptyStateLabel" styleClass="empty-state" wrapText="true" managed="false" visible="false"/>
        <VBox styleClass="table-container" VBox.vgrow="ALWAYS" maxWidth="Infinity">
            <TableView fx:id="table" styleClass="catalog-table" VBox.vgrow="ALWAYS" minHeight="240" maxWidth="Infinity">
                <columns>
                    <TableColumn fx:id="requestCol" text="Yêu cầu" sortable="true"/>
                    <TableColumn fx:id="codeCol" text="Mã hàng" sortable="true"/>
                    <TableColumn fx:id="unitCol" text="ĐVT" sortable="true"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</VBox>
