<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderingsystem.fx.presentation.sales.SalesTrackingController"
      spacing="16" styleClass="screen" maxWidth="Infinity">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <Label text="Theo dõi yêu cầu" styleClass="screen-title"/>

    <VBox styleClass="content-card" maxWidth="Infinity">
        <Label text="Tìm kiếm" styleClass="section-heading"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="6">
                <Label text="Trạng thái" styleClass="field-label"/>
                <ComboBox fx:id="statusFilter" prefWidth="160"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Từ" styleClass="field-label"/>
                <DatePicker fx:id="fromPicker"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Đến" styleClass="field-label"/>
                <DatePicker fx:id="toPicker"/>
            </VBox>
            <VBox spacing="6" alignment="BOTTOM_LEFT">
                <Label text=" " styleClass="field-label"/>
                <Button text="Tìm" onAction="#onSearch" styleClass="btn-primary"/>
            </VBox>
        </HBox>
    </VBox>

    <VBox styleClass="content-card" maxWidth="Infinity">
        <Label text="Danh sách yêu cầu" styleClass="section-heading"/>
        <SplitPane dividerPositions="0.55" prefHeight="320" minHeight="320" maxHeight="320" maxWidth="Infinity">
            <VBox spacing="8" maxWidth="Infinity">
                <VBox fx:id="tableContainer" styleClass="table-container" prefHeight="240" minHeight="240" maxHeight="240" maxWidth="Infinity">
                    <TableView fx:id="listTable" styleClass="catalog-table" maxWidth="Infinity">
                        <columns>
                            <TableColumn fx:id="idCol" text="Mã YC" sortable="true"/>
                            <TableColumn fx:id="createdCol" text="Tạo lúc" sortable="true"/>
                            <TableColumn fx:id="itemsCol" text="Dòng" sortable="true"/>
                            <TableColumn fx:id="statusCol" text="Trạng thái" sortable="true"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
            <VBox spacing="8" styleClass="detail-panel" maxWidth="Infinity">
                <padding>
                    <Insets top="8" right="8" bottom="8" left="16"/>
                </padding>
                <Label text="Chi tiết yêu cầu" styleClass="section-heading"/>
                <TextArea fx:id="detailArea" VBox.vgrow="ALWAYS" editable="false" wrapText="true"
                          promptText="Chọn dòng trong bảng để xem chi tiết…" maxWidth="Infinity"/>
            </VBox>
        </SplitPane>
    </VBox>
</VBox>
