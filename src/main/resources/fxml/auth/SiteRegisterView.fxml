<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.orderingsystem.fx.presentation.auth.SiteRegisterController"
      alignment="CENTER" spacing="16" styleClass="login-root">
    <padding><Insets top="40" right="48" bottom="40" left="48"/></padding>
    <Label styleClass="title" text="Đăng ký tài khoản Site"/>
    <Label text="Chỉ dành đại diện Site nhập khẩu — mã Site phải do Bộ phận Đặt hàng quốc tế khai báo trước."
           wrapText="true" maxWidth="440" styleClass="help-banner"/>
    <Label fx:id="screenStatusLabel" styleClass="screen-status" wrapText="true" maxWidth="420"/>
    <VBox spacing="8" styleClass="form-card" maxWidth="400">
        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
        <Label text="Mã Site *"/>
        <ComboBox fx:id="siteCombo" promptText="Chọn Site chưa có tài khoản" maxWidth="Infinity"/>
        <Label text="Tên đăng nhập *"/>
        <TextField fx:id="usernameField" promptText="vd. site_tokyo"/>
        <Label text="Mật khẩu *"/>
        <PasswordField fx:id="passwordField" promptText="Tối thiểu 6 ký tự"/>
        <Label text="Nhập lại mật khẩu *"/>
        <PasswordField fx:id="confirmPasswordField" onAction="#onRegister" promptText="••••••••"/>
        <Button fx:id="registerButton" text="Đăng ký" onAction="#onRegister" defaultButton="true" styleClass="btn-primary"/>
        <Button text="Quay lại đăng nhập" onAction="#onBackToLogin" styleClass="btn-link"/>
    </VBox>
</VBox>
