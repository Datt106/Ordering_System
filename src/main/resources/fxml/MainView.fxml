<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.orderingsystem.fx.ui.main.MainController">
    <top>
        <VBox spacing="6.0" styleClass="header">
            <padding>
                <Insets bottom="16.0" left="24.0" right="24.0" top="20.0"/>
            </padding>
            <Label styleClass="title" text="Ordering System"/>
            <Label fx:id="subtitleLabel" styleClass="subtitle" wrapText="true"/>
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="12.0" styleClass="content">
            <padding>
                <Insets bottom="32.0" left="32.0" right="32.0" top="32.0"/>
            </padding>
            <Label styleClass="hint" text="Khung JavaFX — chạy: mvn javafx:run"/>
        </VBox>
    </center>
</BorderPane>
